<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.rdt</groupId>
        <artifactId>redis-distributed-toolkit</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>rdt-console</artifactId>
    <name>RDT Console</name>
    <description>Standalone Redis Distributed Toolkit management console</description>
    <properties>
        <spring-boot.run.jvmArguments>-Xms32m -Xmx256m -XX:+UseSerialGC</spring-boot.run.jvmArguments>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.rdt</groupId>
            <artifactId>rdt-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/console</directory>
            </resource>
        </resources>
        <plugins>
            <!-- Build-time Node/pnpm only; the executable JAR serves the resulting files itself. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <workingDirectory>${project.basedir}/web</workingDirectory>
                    <executable>pnpm</executable>
                </configuration>
                <executions>
                    <execution>
                        <id>console-ui-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <arguments><argument>install</argument><argument>--frozen-lockfile</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>console-ui-build</id>
                        <phase>prepare-package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <arguments><argument>run</argument><argument>build</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>console-jvm-options</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>jvm.options</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
